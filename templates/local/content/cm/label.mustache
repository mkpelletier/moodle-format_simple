{{!
    @template format_simple/local/content/cm/label

    A label rendered as section copy.

    A label has no page of its own, so it is shown as the text it carries rather than as a card
    linking somewhere. Its editing controls appear on hover, as elsewhere in this format.

    Context variables required for this template:
    * id int Course module id
    * inlinecontent string The label's formatted text
    * ishidden bool Whether the activity is hidden from students
    * isstealth bool Whether the activity is available but not shown on the course page
    * editing bool Whether editing mode is on
    * hascmcontrolmenu bool Whether there is an editing menu to show
    * cmcontrolmenu string The rendered editing menu

    Example context (json):
    {
        "id": 42,
        "inlinecontent": "<p>Read the following before continuing.</p>",
        "ishidden": false,
        "isstealth": false,
        "editing": false,
        "hascmcontrolmenu": false,
        "cmcontrolmenu": ""
    }
}}
<div class="simple-label {{#ishidden}}is-dimmed{{/ishidden}} {{#isstealth}}is-dimmed is-stealth{{/isstealth}}"
     id="module-{{id}}"
     data-for="cmitem"
     data-id="{{id}}"
     data-zone="label">
    <div class="simple-label-content">
        {{{inlinecontent}}}
    </div>
    {{#editing}}
    {{#hascmcontrolmenu}}
    <div class="simple-cm-edit">
        {{{cmcontrolmenu}}}
    </div>
    {{/hascmcontrolmenu}}
    {{/editing}}
</div>
