{{!
    @template format_simple/local/content/cm/indicator

    Compact completion indicator for an activity card.

    A small squircle at the end of the card. Manual completion renders it as a checkbox the
    student can toggle; every other kind of tracking renders it read only, since those states
    are earned elsewhere. Deliberately built from spans so that it can sit inside the card's
    link, which a button could not.

    Context variables required for this template:
    * id int Course module id
    * completionenabled bool Whether completion is tracked for this activity
    * ismanualcompletion bool Whether the student marks this activity complete themselves
    * iscomplete bool Whether the activity is currently complete
    * completionstate string Either complete or incomplete, counted by the progress ring
    * name string The activity name, used for the accessible label

    Example context (json):
    {
        "id": 42,
        "completionenabled": true,
        "ismanualcompletion": true,
        "iscomplete": false,
        "completionstate": "incomplete",
        "name": "Reading one"
    }
}}
{{#completionenabled}}
{{#ismanualcompletion}}
<span class="simple-cm-dot is-manual {{#iscomplete}}is-complete{{/iscomplete}}"
      role="checkbox"
      tabindex="0"
      aria-checked="{{#iscomplete}}true{{/iscomplete}}{{^iscomplete}}false{{/iscomplete}}"
      aria-label="{{#iscomplete}}{{#str}}marknotcompletename, format_simple, {{name}}{{/str}}{{/iscomplete}}{{^iscomplete}}{{#str}}markcompletename, format_simple, {{name}}{{/str}}{{/iscomplete}}"
      data-action="toggle-completion"
      data-cmid="{{id}}"
      data-completion-tracked="1"
      data-completion-state="{{completionstate}}"></span>
{{/ismanualcompletion}}
{{^ismanualcompletion}}
<span class="simple-cm-dot {{#iscomplete}}is-complete{{/iscomplete}}"
      role="img"
      aria-label="{{#iscomplete}}{{#str}}completedname, format_simple, {{name}}{{/str}}{{/iscomplete}}{{^iscomplete}}{{#str}}notcompletedname, format_simple, {{name}}{{/str}}{{/iscomplete}}"
      data-completion-tracked="1"
      data-completion-state="{{completionstate}}"></span>
{{/ismanualcompletion}}
{{/completionenabled}}
